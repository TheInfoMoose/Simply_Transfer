<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplyTransfer.Core\SimplyTransfer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <Target Name="CopyAlphaVssNative" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\AlphaVSS.x64.dll" DestinationFolder="$(TargetDir)" Condition="Exists('$(TargetDir)runtimes\win-x64\native\AlphaVSS.x64.dll')" />
    <Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\Ijwhost.dll" DestinationFolder="$(TargetDir)" Condition="Exists('$(TargetDir)runtimes\win-x64\native\Ijwhost.dll')" />
    <Copy SourceFiles="$(PublishDir)runtimes\win-x64\native\AlphaVSS.x64.dll" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes\win-x64\native\AlphaVSS.x64.dll')" />
    <Copy SourceFiles="$(PublishDir)runtimes\win-x64\native\Ijwhost.dll" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes\win-x64\native\Ijwhost.dll')" />
  </Target>

</Project>
