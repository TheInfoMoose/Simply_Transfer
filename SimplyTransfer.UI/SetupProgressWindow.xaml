<Window x:Class="SimplyTransfer.UI.SetupProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simply Transfer - Host Configuration" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Configuring Host Environment..." FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <Border Grid.Row="1" BorderBrush="#ccc" BorderThickness="1" Background="#f9f9f9" Padding="5">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogTextBlock" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#333"/>
            </ScrollViewer>
        </Border>
        
        <ProgressBar Grid.Row="2" x:Name="ActivityProgressBar" Height="20" IsIndeterminate="True" Margin="0,15,0,0"/>
    </Grid>
</Window>
