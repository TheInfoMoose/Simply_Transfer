<UserControl x:Class="SimplyTransfer.UI.Controls.ValidationBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="BadgeBorder" 
            CornerRadius="12" 
            Padding="8,3" 
            Background="#252D38"
            BorderBrush="#3B485A"
            BorderThickness="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Icon container -->
            <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                <!-- Neutral Pending Dot -->
                <Ellipse x:Name="DotPending" Width="8" Height="8" Fill="#8A99AD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
                <!-- Green Checkmark -->
                <Path x:Name="IconVerified" 
                      Data="M 2,7 L 5,11 L 12,3" 
                      Stroke="#10B981" 
                      StrokeThickness="2" 
                      StrokeStartLineCap="Round" 
                      StrokeEndLineCap="Round"
                      Visibility="Collapsed"/>
                
                <!-- Red Cross -->
                <Path x:Name="IconFailed" 
                      Data="M 3,3 L 11,11 M 11,3 L 3,11" 
                      Stroke="#EF4444" 
                      StrokeThickness="2" 
                      StrokeStartLineCap="Round" 
                      StrokeEndLineCap="Round"
                      Visibility="Collapsed"/>
                
                <!-- Amber Validating Pulse / Spinner -->
                <Ellipse x:Name="IconValidating" 
                         Width="10" Height="10" 
                         Stroke="#F59E0B" 
                         StrokeThickness="2" 
                         StrokeDashArray="2,2" 
                         Visibility="Collapsed"/>
            </Grid>

            <TextBlock x:Name="StatusText" 
                       Text="Pending" 
                       FontSize="11" 
                       FontWeight="SemiBold" 
                       Foreground="#CBD5E1" 
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
