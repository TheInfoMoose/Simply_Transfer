<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- We need Windows for DPAPI (ProtectedData) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="AlphaVSS" Version="2.0.3" />
    <PackageReference Include="AlphaVSS.Native.NetCore" Version="2.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Management.Automation" Version="7.4.6" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\setup-prerequisites.ps1" Link="Scripts\setup-prerequisites.ps1" />
    <EmbeddedResource Include="..\dest_prerequisites.ps1" Link="Scripts\dest_prerequisites.ps1" />
    <EmbeddedResource Include="..\dest-prerequisites.ps1" Link="Scripts\dest-prerequisites.ps1" />
  </ItemGroup>

</Project>
